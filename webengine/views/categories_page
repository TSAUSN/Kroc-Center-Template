(**
  All Categories — [categories_page] single page · the catalog root (/categories/)
  Hero fields are authored here. The category grid reads Traction Rec's
  categories, inlined below from /tractionrec/program_categories.json (no
  request); the tree-wide class finder fetches the four tier files itself.
  Field refs are the instance's own — note the TRIPLE underscore on the hero
  media, which is how WebEngine renders the " - " in the "Hero Image - Desktop"
  labels. (The original note said a drag-in CTA band needed an autolayout call;
  this view has never had one, so drag-in blocks don't render here.)
**)
<script type="application/json" id="kroc-tr-categories">{{ include /tractionrec/program_categories.json }}</script>

<section class="mx-4 mt-4" id="kroc-catalog-hero"></section>

<section class="mx-4 mt-12" id="kroc-catalog-categories"></section>

<section class="mx-4 mb-12 mt-14" id="kroc-catalog-finder"></section>

<script type="text/babel" data-presets="react">
(() => {
  const data = {
    eyebrow: "{{!this.hero_eyebrow}}".trim(),
    title: "{{!this.header_title}}".trim(),
    subtitle: "{{!this.subheader.escapeForJs()}}".trim(),
    heroDesktop: "{{!this.hero_image___desktop.getImage(1400)}}".trim(),
    heroMobile: "{{!this.hero_image___mobile.getImage(800)}}".trim()
  };

  ReactDOM.createRoot(document.getElementById("kroc-catalog-hero")).render(
    <CatalogHero data={data} />
  );

  const gridData = { heading: "Browse by Category", rows: krocTrInline("kroc-tr-categories") };
  ReactDOM.createRoot(document.getElementById("kroc-catalog-categories")).render(
    <CategoriesSection data={gridData} />
  );

  const finderData = { heading: "Search for Classes" };
  ReactDOM.createRoot(document.getElementById("kroc-catalog-finder")).render(
    <ClassFinder data={finderData} />
  );
})();
</script>
