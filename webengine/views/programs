(**
  Program detail — [programs] pageset · Category > Program > Course > Class
  The program's row in the tr_programs dataset (its page relation is this
  item), its courses and their classes, printed into the script below with the
  row snippets in views/datasets/, plus its categories for the crumb. Nothing
  is fetched; the Zesty categories relation is not read. Zesty supplies what
  Traction Rec has no source for: hero image, icon, subtitle and intro copy;
  program_name is only a fallback for an item with no dataset row.
**)
<section class="mx-4 mt-4" id="kroc-program-crumbs"></section>

<section class="mx-4 mt-3" id="kroc-program-hero"></section>

<section class="mx-4 mt-12" id="kroc-program-intro"></section>

<section class="mx-4 mb-12 mt-12" id="kroc-program-courses"></section>

<script type="text/babel" data-presets="react">
(() => {
  const ds = krocDs({
    self: "{{tr_programs.filter(page = '{this.zuid}').zuid}}",
    programs: [
      {{each tr_programs as prg where prg.page = '{this.zuid}'}}
      {{ include /datasets/program.json }},
      {{end-each}}
    ],
    courses: [
      {{each tr_programs as me where me.page = '{this.zuid}'}}
      {{each tr_courses as crs where crs.program = '{me.zuid}' AND crs.active = 1}}
      {{ include /datasets/course.json }},
      {{end-each}}
      {{end-each}}
    ],
    classes: [
      {{each tr_programs as me where me.page = '{this.zuid}'}}
      {{each tr_courses as meCourse where meCourse.program = '{me.zuid}' AND meCourse.active = 1}}
      {{each tr_classes as cls where cls.course = '{meCourse.zuid}' AND cls.active = 1}}
      {{ include /datasets/class.json }},
      {{end-each}}
      {{end-each}}
      {{end-each}}
    ],
    categories: [
      {{each tr_programs as me where me.page = '{this.zuid}'}}
      {{each tr_program_categories as cat where FIND_IN_SET(cat.zuid, '{me.program_categories}')}}
      {{ include /datasets/category.json }},
      {{end-each}}
      {{end-each}}
    ]
  });
  const data = {
    title: krocTrText(ds.self && ds.self.name) || "{{!this.program_name}}".trim(),
    subtitle: "{{!this.hero_subtitle.escapeForJs()}}".trim(),
    iconUrl: "{{!this.program_icon.getImage(96)}}".trim(),
    heroDesktop: "{{!this.hero_image_desktop.getImage(1400)}}".trim(),
    intro: "{{!this.intro_content.escapeForJs()}}".trim()
  };

  ReactDOM.createRoot(document.getElementById("kroc-program-crumbs")).render(
    <CatalogCrumbs kind="program" trail={krocDsTrail("program", ds)} title={data.title} />
  );

  ReactDOM.createRoot(document.getElementById("kroc-program-hero")).render(
    <CatalogHero data={data} />
  );

  if (data.intro) {
    const intro = { __html: data.intro };
    ReactDOM.createRoot(document.getElementById("kroc-program-intro")).render(
      <div className="rounded-card bg-surface px-6 py-10 sm:px-12">
        <div
          className="kroc-prose max-w-none md:columns-2 md:gap-12"
          dangerouslySetInnerHTML={intro}
        ></div>
      </div>
    );
  }

  const coursesData = { heading: "Courses", ds: ds };
  ReactDOM.createRoot(document.getElementById("kroc-program-courses")).render(
    <CoursesSection data={coursesData} />
  );
})();
</script>
