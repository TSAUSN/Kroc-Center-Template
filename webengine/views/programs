(**
  Program detail — [programs] pageset · Category > Program > Course > Class
  Hero + intro are page fields; the Courses listing is fetched client-side from
  /custom-endpoints/courses.json (scoped to this program's zuid), which then
  chains one call to /custom-endpoints/classes.json for the courses on screen.
  The breadcrumb's parent link resolves through the `categories` relation with
  the documented FIND_IN_SET loop — getUrl() gives the real routed path, so it
  stays correct whatever parent path the pageset is configured with.
**)
<section class="mx-4 mt-4" id="kroc-program-crumbs"></section>

<section class="mx-4 mt-3" id="kroc-program-hero"></section>

<section class="mx-4 mt-12" id="kroc-program-intro"></section>

<section class="mx-4 mb-12 mt-12" id="kroc-program-courses"></section>

<script type="text/babel" data-presets="react">
(() => {
  const data = {
    zuid: "{{this.zuid}}",
    title: "{{!this.program_name}}".trim(),
    subtitle: "{{!this.hero_subtitle.escapeForJs()}}".trim(),
    iconUrl: "{{!this.program_icon.getImage(96)}}".trim(),
    heroDesktop: "{{!this.hero_image_desktop.getImage(1400)}}".trim(),
    intro: "{{!this.intro_content.escapeForJs()}}".trim()
  };

  const parents = [
    {{each categories as cat where FIND_IN_SET(cat.zuid, '{this.categories}')}}
    { label: "{{!cat.category_name}}".trim(), url: "{{cat.getUrl()}}" }
    {{cat._arraycomma}}
    {{end-each}}
  ];

  const crumbs = [{ label: "Programs & Classes", url: "/categories/" }]
    .concat(parents.filter((c) => c.label))
    .concat([{ label: data.title }]);

  ReactDOM.createRoot(document.getElementById("kroc-program-crumbs")).render(
    <Breadcrumbs items={crumbs} />
  );

  ReactDOM.createRoot(document.getElementById("kroc-program-hero")).render(
    <CatalogHero data={data} />
  );

  if (data.intro) {
    const intro = { __html: data.intro };
    ReactDOM.createRoot(document.getElementById("kroc-program-intro")).render(
      <div className="rounded-card bg-surface px-6 py-10 sm:px-12">
        <div
          className="kroc-prose max-w-none md:columns-2 md:gap-12"
          dangerouslySetInnerHTML={intro}
        ></div>
      </div>
    );
  }

  const coursesData = { programZuid: data.zuid, heading: "Courses" };
  ReactDOM.createRoot(document.getElementById("kroc-program-courses")).render(
    <CoursesSection data={coursesData} />
  );
})();
</script>
