        tH.setAttribute("aria-selected", String(!rendered));
        frame.hidden = !rendered;
        src.hidden = rendered;
      }
      tR.onclick = function () { pick(true); };
      tH.onclick = function () { pick(false); };
      frame.onload = function () {
        try {
          // Measure the body, not the document: an iframe document is never
          // shorter than the frame itself, so it would report the 150px default.
          frame.style.height = Math.ceil(frame.contentDocument.body.getBoundingClientRect().bottom + 12) + "px";
        } catch (e) { frame.style.height = "220px"; }
      };
      frame.srcdoc = FRAME_CSS + (result.html.trim() ? result.html : "<p style='color:#5f6368'>(empty output)</p>");
      out.appendChild(tabs);
      out.appendChild(frame);
      out.appendChild(src);
      pick(true);
    }

    function execute() {
      go.disabled = true;
      meta.className = "rn-meta";
      meta.textContent = "running on stage…";
      run(ta.value)
        .then(function (result) {
          show(result);
          meta.className = "rn-meta " + (result.ok ? "ok" : "err");
          var t = result.ms ? " · saved " + result.ms.save + "ms, rendered " + result.ms.render + "ms" : "";
          meta.textContent = (result.ok ? "ok" : "Parsley error") + t;
        })
        .catch(function () {
          show({
            ok: false,
            error: "Runner not reachable at " + RUNNER + ". Start it with: cd kroc-tractionrec-sync && npm run runner " +
              "(and allow local network access if the browser asks)."
          });
          meta.className = "rn-meta err";
          meta.textContent = "runner offline";
        })
        .then(function () { go.disabled = false; });
    }

    go.onclick = execute;
    reset.onclick = function () { ta.value = initial; autosize(ta); };
    ta.addEventListener("input", function () { autosize(ta); });
    ta.addEventListener("keydown", function (e) {
      if (e.key === "Enter" && (e.ctrlKey || e.metaKey)) {
        e.preventDefault();
        execute();
      } else if (e.key === "Tab" && !e.shiftKey) {
        e.preventDefault();
        ta.setRangeText("  ", ta.selectionStart, ta.selectionEnd, "end");
      }
    });
    setTimeout(function () { autosize(ta); }, 0);
    return wrap;
  }

  // Every Parsley code block becomes an editor, seeded with its own text.
  var pres = document.querySelectorAll(".trp pre.run");
  for (var i = 0; i < pres.length; i++) {
    pres[i].replaceWith(editor(pres[i].textContent));
  }

  // Part 2 rows: the code behind each result, opened on demand below the row.
  // The site shell can execute page scripts more than once, so each row is
  // marked when wired; the pre blocks above are already gone after one pass.
  var rows = document.querySelectorAll(".trp tr[data-run]:not([data-rn-ready])");
  for (var j = 0; j < rows.length; j++) {
    (function (tr) {
      tr.setAttribute("data-rn-ready", "");
      var btn = el("button", "rn-btn sm", "✎ edit & run");
      btn.type = "button";
      tr.cells[0].appendChild(document.createElement("br"));
      tr.cells[0].appendChild(btn);
      var open = null;
      btn.onclick = function () {
        if (open) {
          open.remove();
          open = null;
          return;
        }
        open = el("tr", "rn-row");
        var td = el("td");
        td.colSpan = tr.cells.length;
        td.appendChild(editor(tr.getAttribute("data-run")));
        open.appendChild(td);
        tr.after(open);
        td.querySelector("textarea").focus();
      };
    })(rows[j]);
  }
})();
</script>

<script>
