<script>
(function () {
  var RUNNER = "http://127.0.0.1:8787";
  var FRAME_CSS =
    "<base target='_blank'><style>body { margin: 10px 12px; font: 14px/1.55 ui-sans-serif, -apple-system, 'Segoe UI', Roboto, sans-serif; color: #1c1b1f; }" +
    " a { color: #0b57d0; } code, pre { font: 12.5px/1.5 ui-monospace, Menlo, monospace; } pre { white-space: pre-wrap; }</style>";

  function el(tag, cls, text) {
    var n = document.createElement(tag);
    if (cls) { n.className = cls; }
    if (text != null) { n.textContent = text; }
    return n;
  }

  function autosize(ta) {
    ta.style.height = "auto";
    ta.style.height = Math.min(ta.scrollHeight + 2, 640) + "px";
  }

  function run(code) {
    return fetch(RUNNER + "/run", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ code: code })
    }).then(function (r) { return r.json(); });
  }

  function editor(initial) {
    var wrap = el("div", "rn");
    var ta = el("textarea", "rn-code");
    ta.value = initial;
    ta.spellcheck = false;
    ta.setAttribute("aria-label", "Parsley code");
    var bar = el("div", "rn-bar");
    var go = el("button", "rn-btn go", "▶ Run");
    var reset = el("button", "rn-btn", "Reset");
    var meta = el("span", "rn-meta", "Ctrl/⌘+Enter");
    go.type = reset.type = "button";
    bar.appendChild(go);
    bar.appendChild(reset);
    bar.appendChild(meta);
    var out = el("div", "rn-out");
    out.hidden = true;
    wrap.appendChild(ta);
    wrap.appendChild(bar);
    wrap.appendChild(out);

    function show(result) {
      out.innerHTML = "";
      out.hidden = false;
      if (!result.ok) {
        var msg = el("div", "rn-msg");
        msg.textContent = result.error;
        out.appendChild(msg);
        return;
      }
      var tabs = el("div", "rn-tabs");
      var tR = el("button", "rn-tab", "Rendered");
      var tH = el("button", "rn-tab", "HTML");
      tR.type = tH.type = "button";
      tabs.appendChild(tR);
      tabs.appendChild(tH);
      var frame = el("iframe", "rn-frame");
      frame.setAttribute("sandbox", "allow-same-origin");
      frame.setAttribute("title", "Parsley output");
      var src = el("pre", "rn-src", result.html.trim() || "(empty output)");
      function pick(rendered) {
        tR.setAttribute("aria-selected", String(rendered));
        tH.setAttribute("aria-selected", String(!rendered));
        frame.hidden = !rendered;
        src.hidden = rendered;
      }
      tR.onclick = function () { pick(true); };
      tH.onclick = function () { pick(false); };
      frame.onload = function () {
        try {
          // Measure the body, not the document: an iframe document is never
          // shorter than the frame itself, so it would report the 150px default.
          frame.style.height = Math.ceil(frame.contentDocument.body.getBoundingClientRect().bottom + 12) + "px";
        } catch (e) { frame.style.height = "220px"; }
      };
      frame.srcdoc = FRAME_CSS + (result.html.trim() ? result.html : "<p style='color:#5f6368'>(empty output)</p>");
      out.appendChild(tabs);
      out.appendChild(frame);
      out.appendChild(src);
      pick(true);
    }

    function execute() {
      go.disabled = true;
      meta.className = "rn-meta";
      meta.textContent = "running on stage…";
      run(ta.value)
        .then(function (result) {
          show(result);
          meta.className = "rn-meta " + (result.ok ? "ok" : "err");
          var t = result.ms ? " · saved " + result.ms.save + "ms, rendered " + result.ms.render + "ms" : "";
          meta.textContent = (result.ok ? "ok" : "Parsley error") + t;
        })
        .catch(function () {
          show({
            ok: false,
            error: "Runner not reachable at " + RUNNER + ". Start it with: cd kroc-tractionrec-sync && npm run runner " +
              "(and allow local network access if the browser asks)."
          });
          meta.className = "rn-meta err";
          meta.textContent = "runner offline";
        })
        .then(function () { go.disabled = false; });
    }

    go.onclick = execute;
    reset.onclick = function () { ta.value = initial; autosize(ta); };
    ta.addEventListener("input", function () { autosize(ta); });
    ta.addEventListener("keydown", function (e) {
      if (e.key === "Enter" && (e.ctrlKey || e.metaKey)) {
        e.preventDefault();
        execute();
      } else if (e.key === "Tab" && !e.shiftKey) {
        e.preventDefault();
        ta.setRangeText("  ", ta.selectionStart, ta.selectionEnd, "end");
      }
    });
    setTimeout(function () { autosize(ta); }, 0);
    return wrap;
  }

  // Every Parsley code block becomes an editor, seeded with its own text.
  var pres = document.querySelectorAll(".trp pre.run");
  for (var i = 0; i < pres.length; i++) {
    pres[i].replaceWith(editor(pres[i].textContent));
  }

  // Matrix rows: the code behind each result, opened on demand below the row.
  // The site shell can execute page scripts more than once, so each row is
  // marked when wired; the pre blocks above are already gone after one pass.
  var rows = document.querySelectorAll(".trp tr[data-run]:not([data-rn-ready])");
  for (var j = 0; j < rows.length; j++) {
    (function (tr) {
      tr.setAttribute("data-rn-ready", "");
      var btn = el("button", "rn-btn sm", "✎ edit & run");
      btn.type = "button";
      tr.cells[0].appendChild(document.createElement("br"));
      tr.cells[0].appendChild(btn);
      var open = null;
      btn.onclick = function () {
        if (open) {
          open.remove();
          open = null;
          return;
        }
        open = el("tr", "rn-row");
        var td = el("td");
        td.colSpan = tr.cells.length;
        td.appendChild(editor(tr.getAttribute("data-run")));
        open.appendChild(td);
        tr.after(open);
        td.querySelector("textarea").focus();
      };
    })(rows[j]);
  }
})();
</script>

{{end-if}}
