  var t0 = performance.now();
  fetch("/tractionrec/courses/a1za6000009AQIbAAO/classes.json")
    .then(function (r) { return r.json(); })
    .then(function (rows) {
      var ms = Math.round(performance.now() - t0);
      el.innerHTML = rows.map(function (k) {
