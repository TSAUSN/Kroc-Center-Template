(**
  Class detail — [classes] pageset · the dated leaf (Traction Rec's Course
  Session Option)
  Every schedule, price and availability fact comes from this class's Traction
  Rec row, inlined at render time by its tractionrec_id (no request). The Zesty
  fields that mirror it (class_name, dates, day_of_week, time, age_range,
  instructors, prices, spots_remaining, enrollment_status, deep_link_url,
  description, courses) are no longer read. Zesty supplies only what Traction
  Rec has no source for: hero image, class type, location and tags.
  class_name is a fallback title for an item with no Traction Rec row.
  A class whose course has hide_class_pages on renders ClassGate instead, which
  sends the visitor to the course page (krocTrClassGate in catalogdata.jsx).
**)
<script type="application/json" id="kroc-tr-self">{{ include /tractionrec/classes/{this.tractionrec_id}.json }}</script>

<section class="mx-4 mb-12 mt-4" id="kroc-class-detail"></section>

<script type="text/babel" data-presets="react">
(() => {
  const tagRows = [
    {{each tags as t where FIND_IN_SET(t.zuid, '{this.tags}')}}
    { label: "{{!t.name}}".trim(), url: "{{t.getUrl()}}" }
    {{t._arraycomma}}
    {{end-each}}
  ];

  const self = krocTrInline("kroc-tr-self");
  const courseUrl = krocTrClassGate(self);
  const data = {
    self: self,
    title: "{{!this.class_name}}".trim(),
    heroWide: "{{!this.hero_image_desktop.getImage(1400)}}".trim(),
    kind: krocLabelCase("{{!this.class_type}}"),
    location: "{{!this.facility_location.escapeForJs()}}".trim(),
    tags: tagRows.filter((t) => t.label)
  };

  ReactDOM.createRoot(document.getElementById("kroc-class-detail")).render(
    courseUrl ? <ClassGate url={courseUrl} /> : <ClassDetail data={data} />
  );
})();
</script>

{{ this.autolayout(auto) }}
