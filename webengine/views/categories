(**
  Category detail — [categories] pageset
  Traction Rec data, inlined at render time by this item's tractionrec_id (no
  request): the category's own row and its programs
  (/tractionrec/program_categories/<id>/programs.json). The name comes from
  Traction Rec; category_name is only a fallback for an item with no Traction
  Rec row. Zesty supplies what Traction Rec has no source for: hero image,
  icon, subtitle and intro copy.
  NOTE: no autolayout call here, so drag-in blocks (featured_programs,
  featured_stories, donation_block) will not render until one is added back.
**)
<script type="application/json" id="kroc-tr-self">{{ include /tractionrec/program_categories/{this.tractionrec_id}.json }}</script>
<script type="application/json" id="kroc-tr-children">{{ include /tractionrec/program_categories/{this.tractionrec_id}/programs.json }}</script>

<section class="mx-4 mt-4" id="kroc-category-crumbs"></section>

<section class="mx-4 mt-3" id="kroc-category-hero"></section>

<section class="mx-4 mt-12" id="kroc-category-intro"></section>

<section class="mx-4 mb-12 mt-12" id="kroc-category-programs"></section>

<script type="text/babel" data-presets="react">
(() => {
  const self = krocTrInline("kroc-tr-self");
  const data = {
    title: krocTrText(self && self.Name) || "{{!this.category_name}}".trim(),
    subtitle: "{{!this.hero_subtitle.escapeForJs()}}".trim(),
    iconUrl: "{{!this.category_icon.getImage(96)}}".trim(),
    heroDesktop: "{{!this.hero_image_desktop.getImage(1400)}}".trim(),
    intro: "{{!this.intro_content.escapeForJs()}}".trim()
  };

  ReactDOM.createRoot(document.getElementById("kroc-category-crumbs")).render(
    <CatalogCrumbs kind="category" self={self} title={data.title} />
  );

  ReactDOM.createRoot(document.getElementById("kroc-category-hero")).render(
    <CatalogHero data={data} />
  );

  if (data.intro) {
    const intro = { __html: data.intro };
    ReactDOM.createRoot(document.getElementById("kroc-category-intro")).render(
      <div className="rounded-card bg-surface px-6 py-10 sm:px-12">
        <div
          className="kroc-prose max-w-none md:columns-2 md:gap-12"
          dangerouslySetInnerHTML={intro}
        ></div>
      </div>
    );
  }

  const programsData = { heading: "Programs", rows: krocTrInline("kroc-tr-children") };
  ReactDOM.createRoot(document.getElementById("kroc-category-programs")).render(
    <ProgramsSection data={programsData} />
  );
})();
</script>
