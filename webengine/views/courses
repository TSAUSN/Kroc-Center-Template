(**
  Course detail — [courses] pageset · Category > Program > Course > Class
  The crumb trail is two levels up, so it resolves through one FIND_IN_SET loop
  over [programs]: the loop's toJson() carries the parent Program's own fields
  AND its resolved `categories` parent, which is enough for both crumbs plus the
  program zuid the "Other courses" sidebar needs. Classes and sibling courses
  are fetched client-side from the same two endpoints the Program page uses.
**)
<section class="mx-4 mt-4" id="kroc-course-crumbs"></section>

<section class="mx-4 mt-3" id="kroc-course-hero"></section>

<section class="mx-4 mb-12 mt-10" id="kroc-course-body"></section>

<script type="text/babel" data-presets="react">
(() => {
  const data = {
    zuid: "{{this.zuid}}",
    title: "{{!this.course_name}}".trim(),
    subtitle: "{{!this.hero_subtitle.escapeForJs()}}".trim(),
    heroDesktop: "{{!this.hero_image_desktop.getImage(1400)}}".trim(),
    description: "{{!this.description.escapeForJs()}}".trim()
  };

  const parents = [
    {{each programs as p where FIND_IN_SET(p.zuid, '{this.programs}')}}
    { item: {{p.toJson()}}, url: "{{p.getUrl()}}" }
    {{p._arraycomma}}
    {{end-each}}
  ];

  const parent = parents[0] || {};
  const program = parent.item || {};
  const category = krocFirstOf(program.categories);

  data.programZuid = krocZuid(program);

  const categoryUrl =
    (category && category.meta && category.meta.web && category.meta.web.uri) || "";
  const crumbs = [
    { label: "Programs & Classes", url: "/categories/" },
    { label: category ? String(category.category_name || "").trim() : "", url: categoryUrl },
    { label: String(program.program_name || "").trim(), url: parent.url || "" },
    { label: data.title }
  ].filter((c) => c.label);

  ReactDOM.createRoot(document.getElementById("kroc-course-crumbs")).render(
    <Breadcrumbs items={crumbs} />
  );

  ReactDOM.createRoot(document.getElementById("kroc-course-hero")).render(
    <CatalogHero data={data} />
  );

  ReactDOM.createRoot(document.getElementById("kroc-course-body")).render(
    <CourseDetail data={data} />
  );
})();
</script>
