(**
  Course detail — [courses] pageset · Category > Program > Course > Class
  Traction Rec data, inlined at render time by this item's tractionrec_id (no
  request): the course's own row — name and description — and its classes
  (/tractionrec/courses/<id>/classes.json). Sibling courses and the crumb
  trail are fetched by CourseDetail / CatalogCrumbs from the program's files.
  The Zesty `description` and `programs` fields are no longer read. Zesty
  supplies the hero image and subtitle; course_name is only a fallback for an
  item with no Traction Rec row.
**)
<script type="application/json" id="kroc-tr-self">{{ include /tractionrec/courses/{this.tractionrec_id}.json }}</script>
<script type="application/json" id="kroc-tr-children">{{ include /tractionrec/courses/{this.tractionrec_id}/classes.json }}</script>

<section class="mx-4 mt-4" id="kroc-course-crumbs"></section>

<section class="mx-4 mt-3" id="kroc-course-hero"></section>

<section class="mx-4 mb-12 mt-10" id="kroc-course-body"></section>

<script type="text/babel" data-presets="react">
(() => {
  const self = krocTrInline("kroc-tr-self");
  const data = {
    title: krocTrText(self && self.Name) || "{{!this.course_name}}".trim(),
    subtitle: "{{!this.hero_subtitle.escapeForJs()}}".trim(),
    heroDesktop: "{{!this.hero_image_desktop.getImage(1400)}}".trim(),
    self: self,
    classRows: krocTrInline("kroc-tr-children")
  };

  ReactDOM.createRoot(document.getElementById("kroc-course-crumbs")).render(
    <CatalogCrumbs kind="course" self={self} title={data.title} />
  );

  ReactDOM.createRoot(document.getElementById("kroc-course-hero")).render(
    <CatalogHero data={data} />
  );

  ReactDOM.createRoot(document.getElementById("kroc-course-body")).render(
    <CourseDetail data={data} />
  );
})();
</script>
