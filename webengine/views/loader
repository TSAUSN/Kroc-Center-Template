<script type="text/babel" data-presets="react">
function CurrentView() {
  const mainRef = React.useRef(null);

  React.useEffect(() => {
    const tpl = document.getElementById("kroc-current-view");
    if (!tpl || !mainRef.current || mainRef.current.childNodes.length) {
      return;
    }
    mainRef.current.appendChild(tpl.content);
    // revive block scripts (adopted scripts don't run); compile text/babel here
    mainRef.current.querySelectorAll("script:not([type='application/json'])").forEach((inert) => {
      const live = document.createElement("script");
      try {
        if (inert.type === "text/babel") {
          live.textContent = Babel.transform(inert.textContent, { presets: ["react"] }).code;
        } else {
          for (const attr of inert.attributes) {
            live.setAttribute(attr.name, attr.value);
          }
          live.textContent = inert.textContent;
        }
        inert.replaceWith(live);
      } catch (err) {
        console.error("KROC: failed to revive block script", err);
      }
    });
  }, []);

  return <main className="flex-1" ref={mainRef}></main>;
}

// Internal tool pages render without site chrome so a preview is unobstructed
// and cannot be mistaken for a live page. Parsley supplies the page identity
// server-side through the page.zuid accessor (the same one shared.jsx uses);
// the pathname is a second, human-readable signal in case the page is
// recreated and its ZUID changes. The comparison runs in JS rather than a
// Parsley conditional because equality inside a Parsley if-tag is unverified
// here — every conditional in this repo tests truthiness only.
//
// NEVER write a Parsley tag inside a comment in a view. Parsley parses
// comments too: an earlier version of this note spelled out a literal if-tag
// and took every page on the instance down with a WebEngine Parsley error.
const KROC_CHROMELESS_PAGES = ["7-bcd1dfbfcc-jrj0vm"]; // Blocks Catalog
const KROC_NO_CHROME =
  KROC_CHROMELESS_PAGES.indexOf("{{!page.zuid}}".trim()) !== -1 ||
  window.location.pathname.indexOf("/blocks-catalog-page") === 0;

function App() {
  return (
    <div className="mx-auto flex min-h-screen flex-col max-w-7xl">
      {!KROC_NO_CHROME && <SiteHeader />}
      <CurrentView />
      {!KROC_NO_CHROME && <SiteFooter />}
    </div>
  );
}

ReactDOM.createRoot(document.getElementById("root")).render(<App />);
</script>