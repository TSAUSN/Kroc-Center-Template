<script type="text/babel" data-presets="react">
function CurrentView() {
  const mainRef = React.useRef(null);

  React.useEffect(() => {
    const tpl = document.getElementById("kroc-current-view");
    if (!tpl || !mainRef.current || mainRef.current.childNodes.length) {
      return;
    }
    mainRef.current.appendChild(tpl.content);
    // revive block scripts (adopted scripts don't run); compile text/babel here
    mainRef.current.querySelectorAll("script:not([type='application/json'])").forEach((inert) => {
      const live = document.createElement("script");
      try {
        if (inert.type === "text/babel") {
          live.textContent = Babel.transform(inert.textContent, { presets: ["react"] }).code;
        } else {
          for (const attr of inert.attributes) {
            live.setAttribute(attr.name, attr.value);
          }
          live.textContent = inert.textContent;
        }
        inert.replaceWith(live);
      } catch (err) {
        console.error("KROC: failed to revive block script", err);
      }
    });
  }, []);

  return <main className="flex-1" ref={mainRef}></main>;
}

function App() {
  return (
    <div className="mx-auto flex min-h-screen flex-col max-w-7xl">
      <SiteHeader />
      <CurrentView />
      <SiteFooter />
    </div>
  );
}

ReactDOM.createRoot(document.getElementById("root")).render(<App />);
</script>